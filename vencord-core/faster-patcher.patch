+/**
+ * Every plain-text find of the patches still waiting, as one search.
+ *
+ * Checking each find against each module one at a time was most of what loading Discord cost
+ * with plugins: measured 1.1 s for 177 finds over 15k modules, against 0.37 s this way, with the
+ * same matches. Rebuilt whenever the list of waiting patches changes - it shrinks as they apply.
+ */
+function plainFinds(): RegExp {
+    const cache = plainFindsCache;
+    if (cache && cache.length === patches.length && cache.first === patches[0] && cache.last === patches[patches.length - 1]) {
+        return cache.regex;
+    }
+
+    const special = "\\^$.*+?()[]{}|/";
+    const escape = (text: string) => [...text].map(char => special.includes(char) ? "\\" + char : char).join("");
+    const plain = patches.filter(patch => typeof patch.find === "string").map(patch => escape(patch.find as string));
+
+    // matches nothing when there is nothing to look for
+    const regex = plain.length ? new RegExp(plain.join("|")) : /(?!)/;
+    plainFindsCache = { length: patches.length, first: patches[0], last: patches[patches.length - 1], regex };
+    return regex;
+}
